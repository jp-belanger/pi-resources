# syntax=docker/dockerfile:1
# Pin the base and downloaded toolchains so image updates are deliberate and
# auditable. The image tag and immutable digest are updated after each build.
FROM ubuntu@sha256:52df9b1ee71626e0088f7d400d5c6b5f7bb916f8f0c82b474289a4ece6cf3faf

ARG DEBIAN_FRONTEND=noninteractive
ARG NODE_VERSION=26.7.0
ARG NODE_SHA256=982aa24dd8be4c889c6a8ab337ddff3b0896645b20f4239356e80552c16277ee
ARG RUST_VERSION=1.85.1
ARG JUST_VERSION=1.40.0
ARG UV_VERSION=0.9.24
ARG UV_SHA256=fb13ad85106da6b21dd16613afca910994446fe94a78ee0b5bed9c75cd066078

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

RUN apt-get update \
  && apt-get install --yes --no-install-recommends \
    bash \
    build-essential \
    ca-certificates \
    clang \
    curl \
    git \
    gh \
    jq \
    libssl-dev \
    passwd \
    pkg-config \
    ripgrep \
    xz-utils \
  && rm -rf /var/lib/apt/lists/*

RUN curl --fail --location --silent --show-error \
      "https://nodejs.org/download/release/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-x64.tar.xz" \
      --output /tmp/node.tar.xz \
  && echo "${NODE_SHA256}  /tmp/node.tar.xz" | sha256sum --check --strict \
  && tar --extract --file /tmp/node.tar.xz --directory /usr/local --strip-components=1 \
  && rm /tmp/node.tar.xz \
  && npm install --global pnpm@11.18.0

RUN curl --proto '=https' --tlsv1.2 --fail --location --silent --show-error \
      "https://github.com/astral-sh/uv/releases/download/${UV_VERSION}/uv-x86_64-unknown-linux-gnu.tar.gz" \
      --output /tmp/uv.tar.gz \
  && echo "${UV_SHA256}  /tmp/uv.tar.gz" | sha256sum --check --strict \
  && tar --extract --file /tmp/uv.tar.gz --directory /tmp \
  && install -m 0755 /tmp/uv-x86_64-unknown-linux-gnu/uv /usr/local/bin/uv \
  && install -m 0755 /tmp/uv-x86_64-unknown-linux-gnu/uvx /usr/local/bin/uvx \
  && rm -rf /tmp/uv.tar.gz /tmp/uv-x86_64-unknown-linux-gnu

ENV RUSTUP_HOME=/opt/rustup
ENV CARGO_HOME=/opt/cargo
ENV PATH=/opt/cargo/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
RUN curl --proto '=https' --tlsv1.2 --fail --location --silent --show-error \
      https://sh.rustup.rs \
      | sh -s -- -y --profile minimal --default-toolchain "${RUST_VERSION}" \
  && rustup component add rustfmt clippy \
  && rustup set profile default \
  && cargo install just --version "${JUST_VERSION}" --locked

RUN useradd --create-home --shell /bin/bash --uid 10001 developer \
  && mkdir -p /workspace \
  && chown -R developer:developer /workspace /opt/cargo /opt/rustup \
  && git config --system --add safe.directory /workspace \
  && cat > /usr/local/bin/git-credential-msb-github <<'EOF'
#!/bin/sh
# Git sends credential fields on standard input. Return the Microsandbox
# placeholder only for HTTPS requests to github.com. The guest never receives
# the real token; Microsandbox substitutes it at the approved TLS boundary.
case "$1" in
  get)
    protocol=
    host=
    while IFS='=' read -r key value; do
      case "$key" in
        protocol) protocol=$value ;;
        host) host=$value ;;
      esac
    done
    if [ "$protocol" = https ] && [ "$host" = github.com ] && [ -n "${GH_TOKEN:-}" ]; then
      printf 'username=x-access-token\npassword=%s\n\n' "$GH_TOKEN"
    fi
    ;;
esac
EOF
RUN chmod 0755 /usr/local/bin/git-credential-msb-github \
  && git config --system credential.https://github.com.helper msb-github

# Keep GitHub CLI state in the disposable guest filesystem instead of the
# mounted workspace or the image user's home directory.
ENV GH_CONFIG_DIR=/tmp/gh-config
WORKDIR /workspace
USER developer
